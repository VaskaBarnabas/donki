# ============================================================================================================
# A felhasználó által kitöltendő értékek. A konténeres rendszer BELSŐ titkait (adatbázis-jelszavak, rendszerenkénti
# JWT-titkok, a CRM/raktár API-kulcsai, a portál átmeneti admin-kulcsai, az MCP demo-tokenek) NEM itt kell megadni:
# azokat az `npm run stack:secrets` generálja a git-ből kizárt .env.stack fájlba.
# ============================================================================================================

# Supabase – csak a felhasználók és a bejelentkezés (15. fázis óta a modulok adatai a saját adatbázisukban vannak)
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# csak a parancssori eszközökhöz (a portál nem kapja meg)
SUPABASE_SERVICE_ROLE_KEY=
# a `npx supabase db push -p "$SUPABASE_DB_PASSWORD"` migrációkhoz (profiles)
SUPABASE_DB_PASSWORD=

# A legacy rendszerek hozzáférési kulcsai (minden rendszer csak a sajátját és azokét kapja, akiket hív)
LEGACY_QUOTE_KEY=
LEGACY_ORDERS_KEY=
LEGACY_BILLING_KEY=
LEGACY_PAYMENTS_KEY=
LEGACY_SUPPORT_KEY=
# a rendeléskezelő folyamatmotorjának visszahívási kulcsa (Flowable → rendeléskezelő)
LEGACY_ENGINE_KEY=

# A rendeléskezelő folyamatmotorjának (Flowable) REST felhasználója – a beépített rest-admin/test helyett.
# A FLOWABLE_REST_URL csak a gépről futó eszközöknek kell (npm run flowable:deploy, 06-os teszt).
FLOWABLE_REST_URL=http://localhost:8080/flowable-rest/service
FLOWABLE_REST_USER=
FLOWABLE_REST_PASSWORD=

# Stripe (teszt mód – sk_test_ kulcs kötelező). A webhook-titkot a `stripe listen` írja ki; a konténeres
# továbbító (npm run dc -- --profile stripe up -d stripe-cli) ugyanezt a titkot használja.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SzámlaBridge (Stripe → Számlázz.hu tesztfiók). Csak "test" mellett működik a fizetés.
SZAMLABRIDGE_MODE=test
SZAMLABRIDGE_PUBLIC_KEY=

# Számlázz.hu Számla Agent kulcs (16. fázis): a számlázó minden bizonylatot itt állít ki (a Számlázz.hu a gazda).
# KIZÁRÓLAG tesztfiók kulcsa! A számlázó induláskor egy próba-díjbekérővel igazolja, hogy tesztfiók (TST sorszám),
# különben nem állít ki semmit (ERR|E200). Csak a billing konténer kapja meg.
SZAMLAZZHU_AGENT_KEY=

# MCP (opcionális): saját tokenek a demo-tokenek helyett – token:szerepkör:kliensnév, vesszővel elválasztva.
# Szerepkörök: viewer, sales, logistics, finance, sales_manager, admin. Token: pl. openssl rand -hex 24
# Ha üres, az `npm run stack:secrets` szerepkörönként egy demo-tokent generál a .env.stack-be.
MCP_TOKENS=

# Ágens (17. fázis, opcionális – az alapértékek jók): a helyi modell (Ollama) és az ágens saját adatbázisa.
# Modellek: ollama create donki-gemma-e4b -f agens/Modelfile.e4b  (alapértelmezett), ollama create donki-gemma -f agens/Modelfile (12b)
# AGENS_MODEL=donki-gemma-e4b
# AGENS_MODEL_URL=http://127.0.0.1:11434
# AGENS_GONDOLKODAS=0            # 1: a gemma4 „gondolkodás” módja a szakágenseknél (lassabb)
# AGENS_DB_URL=                  # alapból az agens-db (127.0.0.1:54108) az AGENS_DB_PASSWORD-del (.env.stack)
# 18. fázis – háttérfigyelő (a portálból indul, npm run dev). A sor-kulcsait és a monitor MCP tokent a stack:secrets
# generálja a .env.stack-be (ORDERS_SOR_KEY, PAYMENTS_SOR_KEY, INVENTORY_API_KEY, MCP_TOKENS …:monitor:figyelo).
# AGENS_FIGYELO=ki               # nem indul (pl. a tesztek alatt); a Rendszerek oldalon is kikapcsolható
# AGENS_FIGYELO_ESEMENY_MS=15000 # az eseménysorok olvasása
# AGENS_FIGYELO_IDOZITETT_MS=600000  # az időzített ellenőrzések (J4, J6–J9) és a lezárások
# 21. fázis – UCP-átjáró (Universal Commerce Protocol, kereskedői oldal; a stack része, ucp-gateway, 127.0.0.1:4110).
# Az aláíró kulcsát (UCP_ALAIRO_KULCS) és az ucp MCP-tokent (MCP_TOKENS …:ucp:ucp-atjaro) a stack:secrets generálja.
# Ha saját MCP_TOKENS-t adsz meg fent, abba vegyél fel egy ucp szerepkörű tokent is (token:ucp:ucp-atjaro).
# UCP_ALAP_URL=http://localhost:4110   # a kívülről látható cím; élesben HTTPS, a /.well-known/ucp itt érhető el
# UCP_PLATFORMOK=                      # engedélyezett vásárló-platform profilok (URL-előtagok, vesszővel); üres: egyik sem
# UCP_KONFORMANCIA=0                   # 1: csak a hivatalos konformancia-teszthez – szimulált jóváhagyó, teszt-fizetés
# A LangChain felhős nyomkövetője (LangSmith) mindig ki van kapcsolva – ne adj meg LANGSMITH_API_KEY-t.
# stdio-n (helyi kliens) nincs token: a kliens szerepköre és neve
MCP_STDIO_ROLE=viewer
MCP_STDIO_CLIENT=stdio

# Natív portál-fejlesztés (npm run dev – a portál a gépen, a rendszerek konténerben): a rendszerek címei alapból a
# gépre kivezetett portok (localhost:4100–4106), ezeket nem kell megadni.
