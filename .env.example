# Supabase – Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Legacy modulok hozzáférési kulcsai
LEGACY_QUOTE_KEY=
LEGACY_ORDERS_KEY=
LEGACY_BILLING_KEY=
LEGACY_PAYMENTS_KEY=
LEGACY_SUPPORT_KEY=

# Stripe (teszt mód – sk_test_ kulcs kötelező)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SzámlaBridge (Stripe → Számlázz.hu tesztfiók). Csak "test" mellett működik a fizetés.
SZAMLABRIDGE_MODE=test
SZAMLABRIDGE_PUBLIC_KEY=

APP_BASE_URL=http://localhost:3000
ENGINE_CALLBACK_BASE_URL=http://host.docker.internal:3000
LEGACY_ENGINE_KEY=

# Flowable REST
FLOWABLE_REST_URL=http://localhost:8080/flowable-rest/service
FLOWABLE_REST_USER=
FLOWABLE_REST_PASSWORD=

# Supabase session pooler (5432) a Flowable konténerhez
SUPABASE_POOLER_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# MCP szerverek (13. fázis) – a legacy kulcsokat (LEGACY_ORDERS_KEY stb.) és az APP_BASE_URL-t is használják
# HTTP: Bearer tokenek, vesszővel elválasztva, token:szerepkör:kliensnév alakban.
# Szerepkörök: viewer, sales, logistics, finance, sales_manager, admin. Token: pl. openssl rand -hex 24
MCP_TOKENS=
# stdio-n nincs token: a helyi kliens szerepköre és neve (alapból viewer / stdio)
MCP_STDIO_ROLE=viewer
MCP_STDIO_CLIENT=stdio
