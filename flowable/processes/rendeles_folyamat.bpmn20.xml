<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rendelési folyamat (process key: rendeles_folyamat, business key: a rendelésszám).
  Üzleti állapotok: ROGZITETT -> JOVAHAGYOTT -> TELJESITES_ALATT -> SZALLITVA -> SZAMLAZVA -> LEZART, illetve LEMONDOTT.
  Minden integráció a Flowable beépített HTTP taskjával történik (nincs Java delegate / listener):
  a Next.js belső motor-végpontjait hívja (${appBaseUrl}/api/legacy/orders/_engine/<akcio>, X-Engine-Key).
  Indításkor átadott folyamatváltozók: orderNo, appBaseUrl, engineKey.
  A 3. lépés HTTP taskjai nem async-ok: a jóváhagyó hívás szinkron megkapja a foglalás eredményét.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:flowable="http://flowable.org/bpmn"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://legacy-crm/rendeles">

  <message id="msgFizetesBeerkezett" name="FizetesBeerkezett"/>
  <message id="msgRendelesLemondas" name="RendelesLemondas"/>

  <process id="rendeles_folyamat" name="Rendeles folyamat" isExecutable="true">
    <startEvent id="start" name="Rendeles rogzitve"/>
    <serviceTask id="allapot_rogzitett" name="allapot: ROGZITETT" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/allapot]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}, "state": "ROGZITETT", "action": "start"}]]></flowable:expression></flowable:field>
        <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
        <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <userTask id="rendeles_jovahagyasa" name="Rendeles jovahagyasa" flowable:candidateGroups="ertekesitesi_vezeto"/>
    <serviceTask id="keszlet_foglalas" name="Keszlet foglalas" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/keszlet_foglalas]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}}]]></flowable:expression></flowable:field>
        <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
        <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
        <flowable:field name="saveResponseParameters"><flowable:string>true</flowable:string></flowable:field>
        <flowable:field name="saveResponseVariableAsJson"><flowable:string>true</flowable:string></flowable:field>
        <flowable:field name="responseVariableName"><flowable:string>keszletValasz</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="gw_keszlet" name="Foglalas sikeres?" default="f_keszlet_nok"/>
    <serviceTask id="allapot_foglalas_sikertelen" name="allapot: foglalas sikertelen" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/allapot]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}, "ok": false, "action": "approve", "reason": "${keszletValasz.get('reason').asText()}", "detail": "${keszletValasz.get('detail').asText()}"}]]></flowable:expression></flowable:field>
        <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
        <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <serviceTask id="allapot_jovahagyott" name="allapot: JOVAHAGYOTT" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/allapot]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}, "state": "JOVAHAGYOTT", "action": "approve"}]]></flowable:expression></flowable:field>
        <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
        <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <userTask id="kiszallitas_inditasa" name="Kiszallitas inditasa" flowable:candidateGroups="logisztika"/>
    <serviceTask id="szallitas_letrehozasa" name="Szallitas letrehozasa" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/szallitas_letrehozasa]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}}]]></flowable:expression></flowable:field>
        <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
        <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <serviceTask id="allapot_teljesites_alatt" name="allapot: TELJESITES_ALATT" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/allapot]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}, "state": "TELJESITES_ALATT", "action": "fulfil"}]]></flowable:expression></flowable:field>
        <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
        <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <intermediateCatchEvent id="szallitas_varakozas" name="1 perc">
      <timerEventDefinition><timeDuration>PT1M</timeDuration></timerEventDefinition>
    </intermediateCatchEvent>
    <serviceTask id="szallitas_allapot" name="Szallitas allapot" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/szallitas_allapot]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}}]]></flowable:expression></flowable:field>
        <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
        <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
        <flowable:field name="saveResponseParameters"><flowable:string>true</flowable:string></flowable:field>
        <flowable:field name="saveResponseVariableAsJson"><flowable:string>true</flowable:string></flowable:field>
        <flowable:field name="responseVariableName"><flowable:string>szallitasValasz</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="gw_szallitas" name="Fuvarozoi allapot?" default="f_szallitas_var"/>
    <serviceTask id="esemeny_kesik" name="Esemeny: SHIPMENT_DELAYED" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/esemeny]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}, "type": "SHIPMENT_DELAYED"}]]></flowable:expression></flowable:field>
        <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
        <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
        <flowable:field name="saveResponseParameters"><flowable:string>true</flowable:string></flowable:field>
        <flowable:field name="saveResponseVariableAsJson"><flowable:string>true</flowable:string></flowable:field>
        <flowable:field name="responseVariableName"><flowable:string>kesesJelzes</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <serviceTask id="allapot_szallitva" name="allapot: SZALLITVA" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/allapot]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}, "state": "SZALLITVA", "action": "delivered"}]]></flowable:expression></flowable:field>
        <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
        <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <userTask id="szamla_kiallitasa" name="Szamla kiallitasa" flowable:candidateGroups="penzugy"/>
    <serviceTask id="szamlazas" name="Szamlazas" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/szamlazas]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}}]]></flowable:expression></flowable:field>
        <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
        <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
        <flowable:field name="saveResponseParameters"><flowable:string>true</flowable:string></flowable:field>
        <flowable:field name="saveResponseVariableAsJson"><flowable:string>true</flowable:string></flowable:field>
        <flowable:field name="responseVariableName"><flowable:string>szamlazasValasz</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <serviceTask id="invoice_ref_mentes" name="invoiceRef mentese"
                 flowable:expression="${execution.setVariable('invoiceRef', szamlazasValasz.get('invoiceRef').asText())}"/>
    <serviceTask id="allapot_szamlazva" name="allapot: SZAMLAZVA" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/allapot]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}, "state": "SZAMLAZVA", "action": "invoice"}]]></flowable:expression></flowable:field>
        <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
        <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <intermediateCatchEvent id="fizetes_beerkezett" name="FizetesBeerkezett">
      <messageEventDefinition messageRef="msgFizetesBeerkezett"/>
    </intermediateCatchEvent>
    <serviceTask id="allapot_lezart" name="allapot: LEZART" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/allapot]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}, "state": "LEZART", "action": "payment"}]]></flowable:expression></flowable:field>
        <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
        <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <endEvent id="vege" name="Lezarva"/>

    <sequenceFlow id="f_start" sourceRef="start" targetRef="allapot_rogzitett"/>
    <sequenceFlow id="f_rogzitett" sourceRef="allapot_rogzitett" targetRef="rendeles_jovahagyasa"/>
    <sequenceFlow id="f_jovahagyas" sourceRef="rendeles_jovahagyasa" targetRef="keszlet_foglalas"/>
    <sequenceFlow id="f_foglalas" sourceRef="keszlet_foglalas" targetRef="gw_keszlet"/>
    <sequenceFlow id="f_keszlet_ok" name="igen" sourceRef="gw_keszlet" targetRef="allapot_jovahagyott">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${keszletValasz.get('ok').asBoolean()}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_keszlet_nok" name="nem" sourceRef="gw_keszlet" targetRef="allapot_foglalas_sikertelen"/>
    <sequenceFlow id="f_ujra_jovahagyas" sourceRef="allapot_foglalas_sikertelen" targetRef="rendeles_jovahagyasa"/>
    <sequenceFlow id="f_jovahagyott" sourceRef="allapot_jovahagyott" targetRef="kiszallitas_inditasa"/>
    <sequenceFlow id="f_kiszallitas" sourceRef="kiszallitas_inditasa" targetRef="szallitas_letrehozasa"/>
    <sequenceFlow id="f_szallitas_letrehozva" sourceRef="szallitas_letrehozasa" targetRef="allapot_teljesites_alatt"/>
    <sequenceFlow id="f_teljesites" sourceRef="allapot_teljesites_alatt" targetRef="szallitas_varakozas"/>
    <sequenceFlow id="f_timer" sourceRef="szallitas_varakozas" targetRef="szallitas_allapot"/>
    <sequenceFlow id="f_szallitas_lekerdezve" sourceRef="szallitas_allapot" targetRef="gw_szallitas"/>
    <sequenceFlow id="f_kezbesitve" name="KEZBESITVE" sourceRef="gw_szallitas" targetRef="allapot_szallitva">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${szallitasValasz.get('status').asText() == 'KEZBESITVE'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_kesik" name="KESIK (elso)" sourceRef="gw_szallitas" targetRef="esemeny_kesik">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${szallitasValasz.get('status').asText() == 'KESIK' && execution.getVariable('kesesJelzes') == null}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_szallitas_var" name="egyeb" sourceRef="gw_szallitas" targetRef="szallitas_varakozas"/>
    <sequenceFlow id="f_kesik_jelezve" sourceRef="esemeny_kesik" targetRef="szallitas_varakozas"/>
    <sequenceFlow id="f_szallitva" sourceRef="allapot_szallitva" targetRef="szamla_kiallitasa"/>
    <sequenceFlow id="f_szamla" sourceRef="szamla_kiallitasa" targetRef="szamlazas"/>
    <sequenceFlow id="f_szamlazva_http" sourceRef="szamlazas" targetRef="invoice_ref_mentes"/>
    <sequenceFlow id="f_invoice_ref" sourceRef="invoice_ref_mentes" targetRef="allapot_szamlazva"/>
    <sequenceFlow id="f_szamlazva" sourceRef="allapot_szamlazva" targetRef="fizetes_beerkezett"/>
    <sequenceFlow id="f_fizetve" sourceRef="fizetes_beerkezett" targetRef="allapot_lezart"/>
    <sequenceFlow id="f_lezart" sourceRef="allapot_lezart" targetRef="vege"/>

    <subProcess id="lemondas" name="Rendeles lemondasa" triggeredByEvent="true">
      <startEvent id="lemondas_start" name="RendelesLemondas" isInterrupting="true">
        <messageEventDefinition messageRef="msgRendelesLemondas"/>
      </startEvent>
      <serviceTask id="foglalas_feloldasa" name="Foglalas feloldasa" flowable:type="http">
        <extensionElements>
          <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
          <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/foglalas_feloldasa]]></flowable:expression></flowable:field>
          <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
          <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}}]]></flowable:expression></flowable:field>
          <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
          <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
        </extensionElements>
      </serviceTask>
      <exclusiveGateway id="gw_szamlazott" name="Van szamla?" default="f_nincs_szamla"/>
      <serviceTask id="storno" name="Storno" flowable:type="http">
        <extensionElements>
          <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
          <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/storno]]></flowable:expression></flowable:field>
          <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
          <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}}]]></flowable:expression></flowable:field>
          <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
          <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
        </extensionElements>
      </serviceTask>
      <serviceTask id="allapot_lemondott" name="allapot: LEMONDOTT" flowable:type="http">
        <extensionElements>
          <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
          <flowable:field name="requestUrl"><flowable:expression><![CDATA[${appBaseUrl}/api/legacy/orders/_engine/allapot]]></flowable:expression></flowable:field>
          <flowable:field name="requestHeaders"><flowable:expression><![CDATA[Content-Type: application/json
X-Engine-Key: ${engineKey}]]></flowable:expression></flowable:field>
          <flowable:field name="requestBody"><flowable:expression><![CDATA[{"orderNo": ${orderNo}, "state": "LEMONDOTT", "action": "cancel"}]]></flowable:expression></flowable:field>
          <flowable:field name="requestTimeout"><flowable:string>60000</flowable:string></flowable:field>
          <flowable:field name="failStatusCodes"><flowable:string>4XX, 5XX</flowable:string></flowable:field>
        </extensionElements>
      </serviceTask>
      <endEvent id="lemondas_vege" name="Lemondva"/>
      <sequenceFlow id="f_l_start" sourceRef="lemondas_start" targetRef="foglalas_feloldasa"/>
      <sequenceFlow id="f_l_feloldva" sourceRef="foglalas_feloldasa" targetRef="gw_szamlazott"/>
      <sequenceFlow id="f_van_szamla" name="igen" sourceRef="gw_szamlazott" targetRef="storno">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${execution.getVariable('invoiceRef') != null}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="f_nincs_szamla" name="nem" sourceRef="gw_szamlazott" targetRef="allapot_lemondott"/>
      <sequenceFlow id="f_l_storno" sourceRef="storno" targetRef="allapot_lemondott"/>
      <sequenceFlow id="f_l_vege" sourceRef="allapot_lemondott" targetRef="lemondas_vege"/>
    </subProcess>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_rendeles_folyamat">
    <bpmndi:BPMNPlane id="BPMNPlane_rendeles_folyamat" bpmnElement="rendeles_folyamat">
      <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
        <omgdc:Bounds x="50" y="122" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_allapot_rogzitett" bpmnElement="allapot_rogzitett">
        <omgdc:Bounds x="120" y="100" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_rendeles_jovahagyasa" bpmnElement="rendeles_jovahagyasa">
        <omgdc:Bounds x="290" y="100" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_keszlet_foglalas" bpmnElement="keszlet_foglalas">
        <omgdc:Bounds x="460" y="100" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gw_keszlet" bpmnElement="gw_keszlet">
        <omgdc:Bounds x="630" y="115" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_allapot_jovahagyott" bpmnElement="allapot_jovahagyott">
        <omgdc:Bounds x="720" y="100" width="120" height="80"/>
